# run `cp .sample.env .env` to create your local env
# IMPORTANT: this file contains NO working secrets. Fill in SERVER_SECRET and
# SERVER_PASS before starting in production; the server refuses to start in
# production with missing/default/weak values while auth is enabled.

# production server config
HOST=127.0.0.1
PORT=5577
# public URL of the app (used for ws and assets), e.g. https://demo.anubis.locker
# SERVER=https://demo.anubis.locker
# CDN=https://demo.anubis.locker

# Authentication is ON by default. Only ENABLE_AUTH=0 (or false) turns it off,
# which hands a full-access token to every visitor - never do that on a network.
ENABLE_AUTH=1
# JWT signing key, >=32 random chars: openssl rand -hex 32
SERVER_SECRET=
SERVER_USER=admin
# login password, strong and unique: openssl rand -base64 18
SERVER_PASS=
# token lifetime (jsonwebtoken format)
TOKEN_EXPIRED_TIME=12h
# disable local terminal for safety
# DISABLE_LOCAL_TERMINAL=1

# set to 1 (number of proxy hops) when behind nginx so rate limiting sees the
# real client ip; also accepts true / an ip list
# TRUST_PROXY=1
# login rate limit: max failed attempts per ip within the window (ms)
# LOGIN_MAX_FAILS=10
# LOGIN_WINDOW_MS=900000
# extra browser origins allowed by CORS (comma separated); default none = same-origin only
# CORS_ORIGINS=https://other.example.com

# Optional managed external access (production build only).
# One-line installers enable this by default; standalone dev/prod stay opt-in.
# ANUBIS_MANAGED_ACCESS=0  # explicit opt-out for npm run managed / installer
# ANUBIS_MANAGED_URL=https://api.anubis.locker
# ANUBIS_INSTALLATION_LABEL=Anubis Web
# Private identity file, defaults to DB_PATH/managed-installation.json.
# Persist it across restarts; do not publish or share it between installations.
# ANUBIS_INSTALLATION_FILE=
# First enrollment needs administrator fingerprint approval. No administrator
# token belongs here. Browser gateway login AND this app's login stay required.
# Managed mode requires SERVER_PASS >=16 characters, authentication enabled,
# and SERVER/CDN unset (browser assets and sockets remain same-origin).

# MCP server widget (binds to loopback only, bearer token required)
# MCP_ENABLED=false  # disable the managed /mcp adapter (local widget stays independent)
# bearer token clients must send as `Authorization: Bearer <token>`: openssl rand -hex 24
# MCP_TOKEN=
# MCP_ALLOW_REMOTE=1   # allow binding a non-loopback host (e.g. inside a container) - protect it with a firewall/nginx allowlist
# MCP_ALLOW_NO_AUTH=1  # NOT recommended: allow MCP without token
# MCP_CORS_ORIGIN=https://some-ui.example.com

# branding overrides (defaults in src/app/common/brand.config.js)
# BRAND_DOMAIN=anubis.locker
# BRAND_GIT_ORG=ai-security-tool
# BRAND_GIT_REPO=web

# DB_PATH=/some/custom-path-to-db-folder
#
# to use same data as desktop app
# for Mac OS DB_PATH="/Users/<your-user-name>/Library/Application Support/anubis"
# for Linux OS DB_PATH="/home/<your-user-name>/.config/anubis"
# for Windows OS DB_PATH="C:\\Users\\<your-user-name>\\AppData\\Roaming\\anubis"

# dev server host port (dev: also set SERVER_SECRET above, the dev server and
# the app are two processes and must share the same secret)
DEV_HOST=127.0.0.1
DEV_PORT=5580

# folder with the logos/icons package (default ../resource, then node_modules/@ai-security-tool/resource)
# BRAND_RES_DIR=../resource
